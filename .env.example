# Copy to .env and fill in. Never commit .env.

# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# LLM: any OpenAI-compatible endpoint.
# OpenAI:      LLM_BASE_URL=            (leave empty)
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY=ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embeddings
# local  = sentence-transformers on your machine (free, needs torch)
# openai = OpenAI-compatible /embeddings endpoint (uses EMBED_BASE_URL / EMBED_API_KEY)
EMBED_BACKEND=local
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_BASE_URL=
EMBED_API_KEY=
