CREATE CONSTRAINT dokumen_id IF NOT EXISTS FOR (d:Dokumen) REQUIRE d.id IS UNIQUE;
CREATE CONSTRAINT bab_id IF NOT EXISTS FOR (b:Bab) REQUIRE b.id IS UNIQUE;
CREATE CONSTRAINT pasal_id IF NOT EXISTS FOR (p:Pasal) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT ayat_id IF NOT EXISTS FOR (a:Ayat) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT konsep_nama IF NOT EXISTS FOR (k:Konsep) REQUIRE k.nama IS UNIQUE;
CREATE INDEX pasal_dokumen IF NOT EXISTS FOR (p:Pasal) ON (p.dokumen);
CREATE FULLTEXT INDEX konsep_fulltext IF NOT EXISTS FOR (k:Konsep) ON EACH [k.nama];
CREATE FULLTEXT INDEX pasal_fulltext IF NOT EXISTS FOR (p:Pasal) ON EACH [p.isi];
